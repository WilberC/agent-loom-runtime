[Unit]
Description=Agent Loom Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-loom
Group=agent-loom
EnvironmentFile=/etc/agent-loom/runtime.env
LoadCredential=runtime-secret:/etc/agent-loom/runtime-secret
Environment=AGENT_LOOM_RUNTIME_SECRET_FILE=%d/runtime-secret
ExecStart=/usr/local/bin/agent-loom daemon
Restart=on-failure
RestartSec=5
StateDirectory=agent-loom
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-loom

[Install]
WantedBy=multi-user.target
