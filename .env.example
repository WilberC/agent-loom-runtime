# Use either AGENT_LOOM_RUNTIME_SECRET or AGENT_LOOM_RUNTIME_SECRET_FILE, never both.
AGENT_LOOM_CONTROL_PLANE_URL=https://control-plane.example
AGENT_LOOM_RUNTIME_NAME=hermes-runtime
AGENT_LOOM_ENROLLMENT_TOKEN=
AGENT_LOOM_STATE_PATH=/var/lib/agent-loom/runtime.sqlite3
# AGENT_LOOM_RUNTIME_SECRET_FILE=/run/credentials/agent-loom-runtime.service/runtime-secret
AGENT_LOOM_POLL_INTERVAL_SECS=10
AGENT_LOOM_HEARTBEAT_INTERVAL_SECS=30
AGENT_LOOM_REQUEST_TIMEOUT_SECS=30
AGENT_LOOM_HERMES_BINARY=/home/sysadmin/.local/bin/hermes
AGENT_LOOM_HERMES_TIMEOUT_SECS=180
AGENT_LOOM_HERMES_OUTPUT_LIMIT_BYTES=65536
AGENT_LOOM_REPO_SYNC_ROOT=/var/lib/agent-loom/repos
